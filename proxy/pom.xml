      <!-- libthrift 0.24 moved to the jakarta.* namespace and grew server-side transports
           we do not use (thrift is only reached via jaeger-thrift / tchannel). Left alone it
           pulls jakarta.annotation-api 2.x, which drops javax.annotation.Priority and breaks
           RESTEasy 5 - a javax / JAX-RS 2.1 stack - at runtime. -->
      <dependency>
        <groupId>org.apache.thrift</groupId>
        <artifactId>libthrift</artifactId>
        <version>0.24.0</version>
        <scope>compile</scope>
        <exclusions>
          <exclusion>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
          </exclusion>
          <exclusion>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
          </exclusion>
          <!-- thrift's THttpClient transport. We only use thrift for binary
               de/serialization of Jaeger payloads; jaeger-thrift sends over okhttp. -->
          <exclusion>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
          </exclusion>
          <exclusion>
            <groupId>org.apache.httpcomponents.core5</groupId>
            <artifactId>httpcore5</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <!-- Keep the javax-namespace annotation APIs present. grpc dropped its
           javax.annotation-api dependency after 1.62, but RESTEasy 5 still needs
           javax.annotation.Priority; pin both rather than rely on a transitive
           that upstream is free to drop again. -->
      <dependency>
